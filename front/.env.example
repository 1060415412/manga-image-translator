# Frontend proxy target. Keep /api when using the Vite proxy.
VITE_API_BASE=/api

# Backend translator enum: openai, custom_openai, deepseek, gemini, etc.
VITE_LLM_TRANSLATOR=deepseek

# Path is resolved by the manga-image-translator backend process.
VITE_LLM_GPT_CONFIG=./examples/manga_localization_gpt.yaml
